#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
info()    { echo -e "${BLUE}[setup]${NC} $*"; }
success() { echo -e "${GREEN}[setup]${NC} $*"; }
warn()    { echo -e "${YELLOW}[setup]${NC} $*"; }
error()   { echo -e "${RED}[setup]${NC} $*" >&2; exit 1; }

# ── 1. Verificações de pré-requisito ─────────────────────────────────────────
command -v docker >/dev/null 2>&1 || error "Docker não encontrado. Instale o Docker Desktop."
command -v openssl >/dev/null 2>&1 || error "openssl não encontrado. Necessário para gerar certificado SSL."

# ── 2. Arquivo .env ──────────────────────────────────────────────────────────
if [ ! -f .env ]; then
    info "Copiando .env.example → .env"
    cp .env.example .env
    warn "Arquivo .env criado. Revise as configurações se necessário."
    warn "Pressione Enter para continuar ou Ctrl+C para cancelar e editar o .env primeiro."
    read -r
else
    info "Arquivo .env já existe, mantendo configurações atuais."
fi

# ── 3. Certificado SSL autoassinado ──────────────────────────────────────────
if [ ! -f docker/certs/localhost.crt ]; then
    info "Gerando certificado SSL autoassinado para localhost (válido por 10 anos)..."
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout docker/certs/localhost.key \
        -out    docker/certs/localhost.crt \
        -subj   "/C=BR/ST=SP/L=SaoPaulo/O=DevLocal/CN=localhost" \
        2>/dev/null
    success "Certificado SSL gerado em docker/certs/"
else
    info "Certificado SSL já existe, reutilizando."
fi

# ── 4. Build das imagens ──────────────────────────────────────────────────────
info "Construindo imagem Docker (pode demorar 10–20 min na primeira vez)..."
DOCKER_BUILDKIT=1 docker compose build

# ── 5. Subir containers ───────────────────────────────────────────────────────
info "Subindo todos os serviços..."
docker compose up -d

# ── 6. Aguardar o Magento ficar pronto ───────────────────────────────────────
info "Aguardando o Magento finalizar a instalação (pode levar vários minutos)..."
info "Acompanhe os logs em outro terminal com: bin/logs"
printf "    "
TIMEOUT=600
ELAPSED=0
until docker compose exec -T app curl -sf http://localhost/health_check.php >/dev/null 2>&1; do
    printf '.'
    sleep 8
    ELAPSED=$((ELAPSED + 8))
    if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
        echo ""
        error "Timeout aguardando o Magento. Verifique os logs: docker compose logs app"
    fi
done
echo ""
success "Magento está respondendo."

# ── 7. Configurar Redis ───────────────────────────────────────────────────────
info "Configurando Redis para cache de objetos, FPC e sessões..."

docker compose exec -T app php bin/magento setup:config:set \
    --cache-backend=redis \
    --cache-backend-redis-server=redis \
    --cache-backend-redis-db=0 \
    --no-interaction

docker compose exec -T app php bin/magento setup:config:set \
    --page-cache=redis \
    --page-cache-redis-server=redis \
    --page-cache-redis-db=1 \
    --no-interaction

docker compose exec -T app php bin/magento setup:config:set \
    --session-save=redis \
    --session-save-redis-host=redis \
    --session-save-redis-db=2 \
    --no-interaction

# ── 8. Flush de cache ─────────────────────────────────────────────────────────
info "Limpando cache..."
docker compose exec -T app php bin/magento cache:flush

# ── 9. Resumo ─────────────────────────────────────────────────────────────────
echo ""
echo -e "  ┌──────────────────────────────────────────────────────────┐"
echo -e "  │              ${GREEN}Ambiente pronto!${NC}                          │"
echo -e "  ├──────────────────────────────────────────────────────────┤"
echo -e "  │  ${BLUE}Loja:${NC}           https://localhost:8443               │"
echo -e "  │  ${BLUE}Admin:${NC}          https://localhost:8443/admin          │"
echo -e "  │  ${BLUE}phpMyAdmin:${NC}     http://localhost:8081                 │"
echo -e "  │  ${BLUE}Mailpit:${NC}        http://localhost:8025                 │"
echo -e "  │  ${BLUE}Redis Commander:${NC} http://localhost:8082                │"
echo -e "  ├──────────────────────────────────────────────────────────┤"
echo -e "  │  ${YELLOW}Admin user:${NC}     admin                               │"
echo -e "  │  ${YELLOW}Admin pass:${NC}     Admin123!                           │"
echo -e "  │  ${YELLOW}DB user:${NC}        magento / magento                   │"
echo -e "  │  ${YELLOW}DB root:${NC}        root                                │"
echo -e "  └──────────────────────────────────────────────────────────┘"
echo ""
warn "O browser alertará sobre certificado autoassinado."
warn "Clique em 'Avançado' → 'Continuar para localhost' para prosseguir."
echo ""
