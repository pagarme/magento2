# ── Magento App ──────────────────────────────────────────────────────────────
MAGENTO_HOST=localhost:8443
MAGENTO_ENABLE_HTTPS=yes
MAGENTO_MODE=developer

MAGENTO_ADMIN_URL=admin
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin123!
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User

MAGENTO_LANGUAGE=pt_BR
MAGENTO_CURRENCY=BRL
MAGENTO_TIMEZONE=America/Sao_Paulo

# ── Banco de dados ────────────────────────────────────────────────────────────
MAGENTO_DATABASE_NAME=magento
MAGENTO_DATABASE_USER=magento
MAGENTO_DATABASE_PASSWORD=magento
MYSQL_ROOT_PASSWORD=root

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis

# ── SMTP (Mailpit) ────────────────────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025

# ── Xdebug ────────────────────────────────────────────────────────────────────
# Para ativar o Xdebug, edite docker/php/xdebug.ini e rode: bin/rebuild
