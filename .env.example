# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_PORT=80

# ── MariaDB ───────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=root
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
DB_PORT=3306

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_PORT=9200

# ── Magento (used by docker-entrypoint.sh on setup:install) ───────────────────
MAGENTO_HOST=localhost
MAGENTO_ADMIN_URL=admin
MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin@12345
MAGENTO_LANGUAGE=pt_BR
MAGENTO_CURRENCY=BRL
MAGENTO_TIMEZONE=America/Sao_Paulo
MAGENTO_MODE=developer
MAGENTO_ENABLE_HTTPS=no

# Passed to Magento setup:install as --search-engine / --elasticsearch-host
MAGENTO_DATABASE_HOST=db
MAGENTO_DATABASE_PORT_NUMBER=3306
MAGENTO_DATABASE_NAME=magento
MAGENTO_DATABASE_USER=magento
MAGENTO_DATABASE_PASSWORD=magento
ELASTICSEARCH_HOST=opensearch
ELASTICSEARCH_PORT_NUMBER=9200
